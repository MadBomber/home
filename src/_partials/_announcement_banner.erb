<%# The announcement in this page's language; see AnnouncementResolver. %>
<% _ann = (site.data.announcements_by_locale || {})[site.locale.to_s] || site.data.announcement %>
<% if _ann %>
<%
  _ann_href  = _ann["link"].to_s.empty? ? relative_url(_ann["url"]) : _ann["link"]
  _ann_title = _ann["essay"] ? t("banner.new_essay", title: _ann["title"]) : _ann["title"]
%>
<div class="announcement-banner" id="announcement-banner" role="region" aria-label="<%= t("banner.announcement_label") %>" hidden>
  <a href="<%= _ann_href %>" class="announcement-banner-link" id="announcement-banner-link"><%= _ann_title %></a>
  <button type="button" class="announcement-banner-dismiss" id="announcement-banner-dismiss" aria-label="<%= t("banner.dismiss_announcement") %>">&times;</button>
</div>
<% end %>
