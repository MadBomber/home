<% if (site.data.tips_ordered || []).any? %>
<div class="tip-banner" id="tip-banner" role="region" aria-label="Tip of the week" data-feature="tips" hidden>
  <a href="#" class="tip-banner-link" id="tip-banner-link"></a>
  <button type="button" class="tip-banner-dismiss" id="tip-banner-dismiss" aria-label="Dismiss tip">&times;</button>
</div>
<% end %>
