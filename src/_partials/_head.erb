<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<%# Merriweather is self-hosted from /fonts — see the @font-face block at the top
    of frontend/styles/index.css. Do not reintroduce the Google Fonts <link>: it
    hands every reader's IP address to Google on page load, which the privacy
    section of src/documents/about.md says the site does not do. %>
<link rel="preload" href="/fonts/merriweather-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
<%
  resource_title   = strip_html(strip_newlines(title))
  page_title       = resource_title == "Index" ? "#{metadata.title}: #{metadata.tagline}" : "#{resource_title} | #{metadata.title}"
  page_description = (data.description.to_s.empty? ? metadata.description : data.description).to_s.gsub(/\s+/, " ").strip
  canonical_url    = "#{site.config.url}#{resource.relative_url}"
  is_blog_post     = data.layout == "blog_post"
  og_type          = is_blog_post ? "article" : "website"
  og_image         = "#{site.config.url}/images/open_bible.png"
  og_title         = resource_title == "Index" ? metadata.title : resource_title
%>
<title><%= page_title %></title>
<meta name="description" content="<%= page_description %>" />
<% if !data.author.to_s.empty? %><meta name="author" content="<%= data.author %>" /><% end %>
<link rel="canonical" href="<%= canonical_url %>" />
<link rel="sitemap" type="application/xml" href="<%= relative_url '/sitemap.xml' %>" />
<link rel="alternate" type="application/atom+xml" title="<%= metadata.title %> Blog" href="<%= relative_url '/feed.xml' %>" />

<!-- Open Graph -->
<meta property="og:title"       content="<%= og_title %>" />
<meta property="og:description" content="<%= page_description %>" />
<meta property="og:type"        content="<%= og_type %>" />
<meta property="og:url"         content="<%= canonical_url %>" />
<meta property="og:site_name"   content="<%= metadata.title %>" />
<meta property="og:image"       content="<%= og_image %>" />
<% if is_blog_post %>
<% if data.date %><meta property="article:published_time" content="<%= data.date.iso8601 %>" /><% end %>
<% if !data.author.to_s.empty? %><meta property="article:author"         content="<%= data.author %>" /><% end %>
<% end %>

<!-- Twitter Card -->
<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content="<%= og_title %>" />
<meta name="twitter:description" content="<%= page_description %>" />
<meta name="twitter:image"       content="<%= og_image %>" />

<link rel="stylesheet" href="<%= asset_path :css %>" />
<script>
// Apply theme and feature visibility before first paint to prevent FOUC
// NOTE: this runs before the bundle loads, so it cannot import SETTINGS_KEY.
// It is the one hand-kept copy of "bst_settings" — see storage-keys.js.
(function() {
  try {
    var s = JSON.parse(localStorage.getItem("bst_settings") || "{}");
    var theme = s.siteTheme || "light";
    document.documentElement.setAttribute("data-theme", theme);
    document.documentElement.style.fontSize = (parseInt(s.fontSize, 10) || 18) + "px";
    var f = s.features || {};
    var css = "";
    if (f.journal === false) css += '[data-feature="journal"]{display:none!important}';
    if (f.speak === false) css += '[data-feature="speak"]{display:none!important}';
    if (f.group !== true) css += '[data-feature="group"]{display:none!important}';
    if (f.discussions !== true) css += '[data-feature="discussions"]{display:none!important}';
    if (css) {
      var style = document.createElement("style");
      style.textContent = css;
      document.head.appendChild(style);
    }
  } catch(e) {}
})();
</script>
<script src="<%= asset_path :js %>" defer></script>
<script>
  var refTagger = {
    settings: {
      bibleVersion: "ESV",
      tagChapters: true,
      cssOverride: true,
      socialSharing: [],
      linksOpenNewWindow: true,
      roundCorners: true,
      noSearchTagNames: ["h1", "h2", "h3"],
      // The essay search hint cites "Acts 17" as an example of phrase syntax,
      // not as a passage to go read — leave it as plain text.
      noSearchClassNames: ["blog-search-hint"],
      observeAutomatically: true
    }
  };
</script>
<script src="https://api.reftagger.com/v2/RefTagger.js" defer></script>
<script data-goatcounter="https://lamplight.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>
<%= live_reload_dev_js %>
