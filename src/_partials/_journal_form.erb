<%# Prompt library for the "Another prompt" button. Journal pages only: no other
    page needs it, and it is the same data the Journaling document lists. %>
<script id="journal-prompts-data" type="application/json"><%== site.data.journal_prompts.groups.flat_map { |g| g["prompts"] }.to_json %></script>

<article class="journal" id="journal">
  <div class="journal-header">
    <h1 id="journal-title">Journal</h1>
    <p id="journal-context" class="journal-context"></p>
    <%# Filled in by journal.js: the entry's own timestamp, or now if unwritten. %>
    <time id="journal-timestamp" class="journal-timestamp"></time>
    <%# Deliberately not "nothing leaves your device": the group share button
        mails an excerpt, and any script on the page can read localStorage.
        This claim is limited to what the site itself does with the text. %>
    <p class="journal-privacy">Your journal is stored in this browser only. It is never sent to this site's server.</p>
  </div>

  <div id="journal-day-form" class="journal-form-body" style="display:none;">
    <div class="journal-field">
      <%# Ghost text comes from the reader's setting; journal.js fills it in. %>
      <textarea id="journal-text" class="journal-entry" rows="14"
                aria-label="Journal entry"></textarea>
    </div>

    <div id="journal-status" class="journal-status"></div>
  </div>

  <div id="journal-week-view" class="journal-week-view" style="display:none;">
    <div id="journal-week-entries"></div>
  </div>

  <div id="journal-no-params" style="display:none;">
    <p>Select a week to view or add journal entries:</p>
    <div class="journal-week-selector">
      <select id="journal-week-select"></select>
      <button id="journal-week-go" class="journal-week-go-btn">Go</button>
    </div>
  </div>

  <%# Sits outside the three view containers so it shows under whichever one is
      open, once, rather than once per day panel in the week view. %>
  <% _print_path = data.study_slug ? "/#{data.study_slug}/journal/print/" : "/journal/print/" %>
  <p class="journal-backup-note">
    <a href="<%= relative_url _print_path %>">View the whole journal</a> to read, print, or save it as a PDF.
    Clearing your browser data will erase these entries — use the Export button on the
    <a href="<%= relative_url '/settings/' %>">Settings</a> page to keep a copy.
  </p>
</article>
