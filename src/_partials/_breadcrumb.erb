<%
  _study_slug     = resource.data[:study_slug]
  _week           = resource.data[:week]&.to_i
  _section_number = resource.data[:section_number]&.to_i
%>
<% if _study_slug %>
<%
  _data_key  = _study_slug.gsub('-', '_')
  _study_pfx = "/#{_study_slug}"

  _is_production = Bridgetown.environment.to_s == "production"

  _studies      = site.data.studies || []
  # Hidden studies stay reachable through the breadcrumb during development;
  # production omits them (except the study whose page you are already on).
  _studies      = _studies.reject { |s| s["hidden"] && s["slug"] != _study_slug } if _is_production
  _study_data   = _studies.find { |s| s["slug"] == _study_slug }

  # Every word here comes from src/_locales (breadcrumb.*), in the page's
  # language. studies.yml carries title_es beside title; a study without one
  # shows its English title. The Home link goes to the page's own language's
  # home page when there is one.
  _locale        = site.locale.to_s
  _locale_prefix = site.locale.to_sym == site.config.default_locale.to_sym ? "" : "/#{site.locale}"
  _home_path     = site.resources.any? { |r| r.relative_url.to_s == "#{site.base_path}#{_locale_prefix}/" } ? "#{_locale_prefix}/" : "/"
  _title_of      = ->(study) { study["title_#{_locale}"] || study["title"] }

  # The essays' topic pages carry study_slug "blog", which is not a study and
  # has no title of its own; it is called what the menu calls it.
  _study_title  = if _study_data
    _title_of.call(_study_data)
  elsif _study_slug == "blog"
    t("nav.essays")
  else
    _study_slug
  end

  _study_config_data = site.data.respond_to?(_data_key) ? site.data.send(_data_key) : nil
  _study_config      = _study_config_data&.study_config || {}
  _sections          = _study_config["sections"] || []
  _week_phases       = (_study_config_data&.week_phases || {}).transform_keys(&:to_i)
  _has_mv            = _study_config["has_memory_verse"] != false

  _cur_section = if _week
    _sections.find { |s| _week >= s["weeks_start"].to_i && _week <= s["weeks_end"].to_i }
  elsif _section_number
    _sections.find { |s| s["number"].to_i == _section_number }
  end

  _section_slug  = _cur_section&.[]("slug")
  _section_title = _cur_section&.[]("title")

  _chevron = '<svg class="bc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>'

  if _week
    _section_weeks = _week_phases.select { |_w, slug| slug == _section_slug }.keys.sort
    _week_fmt  = "%02d" % _week
    _week_base = "#{_study_pfx}/#{_section_slug}/week-#{_week_fmt}"
    _day       = resource.data[:day]&.to_i
    _page_type = resource.data[:type]
    _page_label = if _day
      t("breadcrumb.day", day: _day)
    elsif _page_type == "discussion"
      t("breadcrumb.discussion")
    elsif _page_type == "memory_verse"
      t("breadcrumb.memory_verse")
    else
      t("breadcrumb.overview")
    end
    _day_pages = [[t("breadcrumb.overview"), "#{_week_base}/overview/"]]
    (1..5).each { |d| _day_pages << [t("breadcrumb.day", day: d), "#{_week_base}/day-#{d}/"] }
    _day_pages << [t("breadcrumb.discussion"), "#{_week_base}/discussion/"]
    _day_pages << [t("breadcrumb.memory_verse"), "#{_week_base}/memory-verse/"] if _has_mv
  end
%>
<nav class="breadcrumb" aria-label="<%= t("breadcrumb.label") %>">
  <ol class="bc-list">

    <li class="bc-item">
      <a href="<%= relative_url _home_path %>" class="bc-link"><%= t("nav.home") %></a>
    </li>
    <li class="bc-sep" aria-hidden="true">›</li>

    <li class="bc-item bc-has-dropdown<%= ' bc-current' unless _cur_section || _week %>">
      <button class="bc-toggle" aria-expanded="false">
        <%= _study_title %><%== _chevron %>
      </button>
      <ul class="bc-dropdown">
        <% _studies.each do |study| %>
          <%
            _study_aria = if study["slug"] == _study_slug
              (!_cur_section && !_week) ? ' aria-current="page"' : ' aria-current="true"'
            else
              ""
            end
          %>
          <li><a href="<%= relative_url "/#{study["slug"]}/" %>"<%== _study_aria %>><%= _title_of.call(study) %></a></li>
        <% end %>
      </ul>
    </li>

    <% if _cur_section %>
    <li class="bc-sep" aria-hidden="true">›</li>

    <li class="bc-item bc-has-dropdown<%= ' bc-current' unless _week %>">
      <button class="bc-toggle" aria-expanded="false">
        <%= _section_title %><%== _chevron %>
      </button>
      <ul class="bc-dropdown">
        <% _sections.each do |sec| %>
          <%
            _sec_aria = if sec["slug"] == _section_slug
              !_week ? ' aria-current="page"' : ' aria-current="true"'
            else
              ""
            end
          %>
          <li><a href="<%= relative_url "#{_study_pfx}/#{sec["slug"]}/" %>"<%== _sec_aria %>><%= sec["title"] %></a></li>
        <% end %>
      </ul>
    </li>
    <% end %>

    <% if _week %>
    <li class="bc-sep" aria-hidden="true">›</li>

    <li class="bc-item bc-has-dropdown">
      <button class="bc-toggle" aria-expanded="false">
        <%= t("breadcrumb.week", week: _week) %><%== _chevron %>
      </button>
      <ul class="bc-dropdown">
        <% _section_weeks.each do |w| %>
          <li><a href="<%= relative_url "#{_study_pfx}/#{_section_slug}/week-#{'%02d' % w}/overview/" %>"<%== ' aria-current="true"' if w == _week %>><%= t("breadcrumb.week", week: w) %></a></li>
        <% end %>
      </ul>
    </li>
    <li class="bc-sep" aria-hidden="true">›</li>

    <li class="bc-item bc-has-dropdown bc-current">
      <button class="bc-toggle" aria-expanded="false">
        <%= _page_label %><%== _chevron %>
      </button>
      <ul class="bc-dropdown">
        <% _day_pages.each do |label, path| %>
          <li><a href="<%= relative_url path %>"<%== ' aria-current="page"' if label == _page_label %>><%= label %></a></li>
        <% end %>
      </ul>
    </li>
    <% end %>

  </ol>
</nav>
<% end %>
