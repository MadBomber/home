<%
  # The Contact link carries the path of the page the reader is leaving, so the
  # subject line arrives naming its address — the same trick the essay byline
  # uses. contact.js pairs the path with the origin it is running on; see
  # prefillTopicFromPage there.
  #
  # Two pages opt out: the contact page itself, whose own address says nothing,
  # and the privacy policy, which is about the site rather than a thing a reader
  # would write in about.
  _here       = resource&.relative_url.to_s
  _no_subject = %W[#{site.base_path}/contact/ #{site.base_path}/privacy_policy/].include?(_here)

  _contact_href = relative_url("/contact/")
  unless _here.empty? || _no_subject
    _contact_href = "#{_contact_href}?about=#{ERB::Util.url_encode(_here)}"
  end
%>
<footer class="site-footer">
  <p>Site content &copy; <%= Time.now.year %> <%= metadata.author %>, licensed under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>. Scripture quotations are excepted &mdash; see below.</p>
  <%# Crossway requires this notice, and a link to esv.org, on every page that
      displays ESV text. Study day pages embed passages, so it lives in the
      footer rather than on individual pages. The CC license above is scoped to
      site content for the same reason: the ESV text is not ours to relicense. %>
  <p class="site-footer-esv">Scripture quotations are from the <a href="https://www.esv.org/">ESV&reg; Bible</a> (The Holy Bible, English Standard Version&reg;), copyright &copy; 2001 by Crossway, a publishing ministry of Good News Publishers. Used by permission. All rights reserved.</p>
  <p class="site-footer-links">
    <a href="<%= _contact_href %>">Contact</a>
    <a href="<%= relative_url "/privacy_policy/" %>">Privacy Policy</a>
  </p>
</footer>
