---
layout: default
title: Tips
description: Short tips to help you get the most out of these Bible studies.
# One template, rendered once per language: /tips/ in English, /es/tips/ in
# Spanish. Each copy lists only the tips in its own language.
locale: multi
locale_overrides:
  es:
    title: Consejos
    description: Consejos breves para que aproveches al máximo estos estudios bíblicos.
---

<%
  tips = (site.data.tips_by_locale || {})[data.locale.to_s] || site.data.tips_ordered || []

  groups = [
    { "slug" => "study", "title" => t("tips.group_study"), "description" => t("tips.group_study_desc") },
    { "slug" => "site",  "title" => t("tips.group_site"), "description" => t("tips.group_site_desc") },
  ].filter_map { |g|
    items = tips.select { |t| t["category"] == g["slug"] }
    items.empty? ? nil : g.merge("items" => items)
  }

  grouped_slugs = groups.flat_map { |g| g["items"].map { |t| t["url"] } }
  ungrouped = tips.reject { |t| grouped_slugs.include?(t["url"]) }
%>

<section class="blog-index">
  <div class="blog-index-hero">
    <h1><%= data.title %></h1>
    <p><%= t("tips.intro") %></p>
  </div>

  <% if tips.empty? %>
    <p class="blog-empty"><%= t("tips.none") %></p>
  <% end %>

  <% groups.each do |group| %>
    <div class="tips-group">
      <h2><%= group["title"] %></h2>
      <p class="tips-group-desc"><%= group["description"] %></p>
      <div class="guide-cards">
        <% group["items"].each do |tip| %>
          <a href="<%= relative_url tip["url"] %>" class="guide-card">
            <h3><%= tip["title"] %></h3>
            <% if tip["description"] %><p><%= tip["description"] %></p><% end %>
          </a>
        <% end %>
      </div>
    </div>
  <% end %>

  <% unless ungrouped.empty? %>
    <div class="tips-group">
      <% if groups.any? %><h2><%= t("tips.more") %></h2><% end %>
      <div class="guide-cards">
        <% ungrouped.each do |tip| %>
          <a href="<%= relative_url tip["url"] %>" class="guide-card">
            <h3><%= tip["title"] %></h3>
            <% if tip["description"] %><p><%= tip["description"] %></p><% end %>
          </a>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
