---
title: Settings
layout: default
permalink: /settings/
---

<article id="settings-page">
  <h1>Settings</h1>
  <p style="text-align:center; color: var(--text-secondary); margin-bottom: 2rem;">Customize your study experience. All settings are stored privately in this browser.</p>

  <section class="settings-section">
    <h2>Features</h2>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-journal" />
        <span class="settings-toggle-text">
          <strong>H.E.A.R. Journaling</strong>
          <span class="settings-toggle-desc">Show the journal icon on day pages</span>
        </span>
      </label>
    </div>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-speak" />
        <span class="settings-toggle-text">
          <strong>Read Aloud</strong>
          <span class="settings-toggle-desc">Show the speak button in the toolbar</span>
        </span>
      </label>
    </div>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-group" />
        <span class="settings-toggle-text">
          <strong>Group Sharing</strong>
          <span class="settings-toggle-desc">Show an email icon in the toolbar to share with your study group</span>
        </span>
      </label>
    </div>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-discussions" />
        <span class="settings-toggle-text">
          <strong>Community Discussions</strong>
          <span class="settings-toggle-desc">Show a comment section at the bottom of content pages. Posting requires a free <a href="https://github.com/signup" target="_blank">GitHub</a> account. All comments are public.</span>
        </span>
      </label>
    </div>
  </section>

  <section class="settings-section">
    <h2>Site Theme</h2>
    <div class="settings-theme-selector">
      <label for="setting-site-theme" class="settings-info">Choose your preferred appearance:</label>
      <select id="setting-site-theme" class="settings-select">
        <option value="light">Light</option>
        <option value="dark">Dark</option>
        <option value="auto">Match System Setting</option>
      </select>
    </div>
  </section>

  <section class="settings-section">
    <h2>Font Size</h2>
    <p class="settings-info">Set your preferred reading size in pixels:</p>
    <div class="font-size-stepper">
      <button id="font-size-decrease" class="font-size-btn" aria-label="Decrease font size">−</button>
      <input type="number" id="font-size-value" class="font-size-input" min="8" max="40" value="18" />
      <button id="font-size-increase" class="font-size-btn" aria-label="Increase font size">+</button>
    </div>
  </section>

  <section class="settings-section" data-feature="journal">
    <h2>Journal Data</h2>
    <p class="settings-info">H.E.A.R. journal entries are tracked separately for each Bible study. Export, import, or clear a single study's entries below.</p>

    <% site.data.studies.reject { |s| s["hidden"] }.each do |study| %>
      <%
        data_key  = study["slug"].gsub('-', '_')
        study_cfg = site.data.send(data_key).study_config
      %>
      <div class="settings-progress-study"
           data-study-slug="<%= study["slug"] %>"
           data-storage-prefix="<%= study_cfg["storage_prefix"] %>">
        <h3 class="settings-progress-study-title"><%= study["title"] %></h3>
        <p class="settings-progress-study-info settings-info"></p>

        <div class="settings-actions">
          <button class="settings-btn settings-export-journal">Export</button>
          <button class="settings-btn settings-import-journal">Import</button>
          <input type="file" class="settings-import-journal-file" accept=".json" style="display:none;" />
          <button class="settings-btn settings-btn-danger settings-clear-journal">Clear Entries</button>
        </div>
      </div>
    <% end %>
  </section>

  <section class="settings-section" data-feature="group" id="group-members">
    <h2>Study Group Members</h2>
    <p id="settings-group-info" class="settings-info"></p>

    <div class="group-member-form">
      <input type="text" id="group-member-name" placeholder="Name" class="group-member-input" />
      <input type="email" id="group-member-email" placeholder="Email address" class="group-member-input group-member-input-email" />
      <button id="group-add-member" class="settings-btn">Add</button>
    </div>

    <div id="group-member-list"></div>

    <div class="settings-actions" style="margin-top: 1rem;">
      <button id="settings-export-group" class="settings-btn">Export</button>
      <button id="settings-import-group" class="settings-btn">Import</button>
      <input type="file" id="settings-import-group-file" accept=".json" style="display:none;" />
      <button id="settings-clear-group" class="settings-btn settings-btn-danger">Clear All Members</button>
    </div>
  </section>

  <section class="settings-section">
    <h2>Progress Data</h2>
    <p class="settings-info">Progress is tracked separately for each Bible study. Export, import, or clear a single study's progress below.</p>

    <% site.data.studies.reject { |s| s["hidden"] }.each do |study| %>
      <%
        data_key  = study["slug"].gsub('-', '_')
        study_cfg = site.data.send(data_key).study_config
      %>
      <div class="settings-progress-study"
           data-study-slug="<%= study["slug"] %>"
           data-storage-prefix="<%= study_cfg["storage_prefix"] %>"
           data-config="<%= study_cfg.to_json %>">
        <h3 class="settings-progress-study-title"><%= study["title"] %></h3>
        <p class="settings-progress-study-info settings-info"></p>

        <div class="settings-actions">
          <button class="settings-btn settings-export-progress">Export</button>
          <button class="settings-btn settings-import-progress">Import</button>
          <input type="file" class="settings-import-progress-file" accept=".json" style="display:none;" />
          <button class="settings-btn settings-btn-danger settings-clear-progress">Clear Progress</button>
        </div>
      </div>
    <% end %>
  </section>

  <section class="settings-section">
    <h2>Storage</h2>
    <p id="settings-storage-info" class="settings-info"></p>
  </section>

  <div id="settings-status" class="settings-status"></div>
</article>
