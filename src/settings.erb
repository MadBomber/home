---
title: Settings
layout: default
permalink: /settings/
# One template, rendered once per language. Every visible string comes from
# src/_locales/*.yml; the settings_js map is injected below for settings.js.
locale: multi
locale_overrides:
  es:
    title: Ajustes
    permalink: /es/settings/
---

<article id="settings-page">
  <h1><%= data.title %></h1>
  <p style="text-align:center; color: var(--text-secondary); margin-bottom: 2rem;"><%= t("settings.intro") %></p>

  <section class="settings-section">
    <h2><%= t("settings.features") %></h2>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-journal" />
        <span class="settings-toggle-text">
          <strong><%= t("settings.journaling") %></strong>
          <span class="settings-toggle-desc"><%= t("settings.journaling_desc") %></span>
        </span>
      </label>
    </div>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-speak" />
        <span class="settings-toggle-text">
          <strong><%= t("settings.read_aloud") %></strong>
          <span class="settings-toggle-desc"><%= t("settings.read_aloud_desc") %></span>
        </span>
      </label>
    </div>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-group" />
        <span class="settings-toggle-text">
          <strong><%= t("settings.group_sharing") %></strong>
          <span class="settings-toggle-desc"><%= t("settings.group_sharing_desc") %></span>
        </span>
      </label>
    </div>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-discussions" />
        <span class="settings-toggle-text">
          <strong><%= t("settings.discussions") %></strong>
          <span class="settings-toggle-desc"><%= t("settings.discussions_desc_html") %></span>
        </span>
      </label>
    </div>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-tips" />
        <span class="settings-toggle-text">
          <strong><%= t("settings.tips") %></strong>
          <span class="settings-toggle-desc"><%= t("settings.tips_desc") %></span>
        </span>
      </label>
    </div>

    <div class="settings-toggle">
      <label class="settings-toggle-label">
        <input type="checkbox" id="setting-quiz" />
        <span class="settings-toggle-text">
          <strong><%= t("settings.quiz") %></strong>
          <span class="settings-toggle-desc"><%= t("settings.quiz_desc") %></span>
        </span>
      </label>
    </div>
  </section>

  <section class="settings-section">
    <h2><%= t("settings.theme") %></h2>
    <div class="settings-theme-selector">
      <label for="setting-site-theme" class="settings-info"><%= t("settings.theme_label") %></label>
      <select id="setting-site-theme" class="settings-select">
        <option value="light"><%= t("settings.theme_light") %></option>
        <option value="dark"><%= t("settings.theme_dark") %></option>
        <option value="auto"><%= t("settings.theme_auto") %></option>
      </select>
    </div>
  </section>

  <section class="settings-section">
    <h2><%= t("settings.font_size") %></h2>
    <p class="settings-info"><%= t("settings.font_size_info") %></p>
    <div class="font-size-stepper">
      <button id="font-size-decrease" class="font-size-btn" aria-label="<%= t("settings.font_decrease") %>">−</button>
      <input type="number" id="font-size-value" class="font-size-input" min="8" max="40" value="18" />
      <button id="font-size-increase" class="font-size-btn" aria-label="<%= t("settings.font_increase") %>">+</button>
    </div>
  </section>

  <section class="settings-section" data-feature="quiz">
    <h2><%= t("settings.quiz") %></h2>
    <p class="settings-info"><%= t("settings.quiz_info") %></p>
    <div class="settings-field">
      <label class="settings-field-label" for="setting-quiz-length"><%= t("settings.quiz_length") %></label>
      <input type="number" id="setting-quiz-length" class="settings-number-input" min="5" max="20" />
    </div>
    <div class="settings-field">
      <label class="settings-field-label" for="setting-quiz-lookback"><%= t("settings.quiz_lookback") %></label>
      <input type="number" id="setting-quiz-lookback" class="settings-number-input" min="1" max="6" />
    </div>
  </section>

  <section class="settings-section" data-feature="journal">
    <h2><%= t("settings.journal_data") %></h2>

    <div class="settings-field">
      <label class="settings-field-label" for="setting-journal-method"><%= t("settings.journal_prompt") %></label>
      <p class="settings-info"><%= t("settings.journal_prompt_info_html", url: relative_url("#{data.locale.to_sym == site.config.default_locale.to_sym ? "" : "/#{data.locale}"}/documents/journaling/")) %></p>
      <select id="setting-journal-method" class="settings-select"></select>
      <textarea id="setting-journal-placeholder" class="settings-textarea" rows="4"></textarea>
    </div>

    <p class="settings-info"><%= t("settings.journal_data_info_html") %></p>

    <% site.data.studies.reject { |s| s["hidden"] }.each do |study| %>
      <%
        data_key  = study["slug"].gsub('-', '_')
        study_cfg = site.data.send(data_key).study_config
      %>
      <div class="settings-progress-study"
           data-study-slug="<%= study["slug"] %>"
           data-storage-prefix="<%= study_cfg["storage_prefix"] %>">
        <h3 class="settings-progress-study-title"><%= study["title"] %></h3>
        <p class="settings-progress-study-info settings-info"></p>

        <div class="settings-actions">
          <a class="settings-btn" href="<%= relative_url "/#{study["slug"]}/journal/print/" %>"><%= t("settings.view_journal") %></a>
          <button class="settings-btn settings-export-journal"><%= t("settings.export") %></button>
          <button class="settings-btn settings-import-journal"><%= t("settings.import") %></button>
          <input type="file" class="settings-import-journal-file" accept=".json" style="display:none;" />
          <button class="settings-btn settings-btn-danger settings-clear-journal"><%= t("settings.clear_entries") %></button>
        </div>
      </div>
    <% end %>
  </section>

  <section class="settings-section" data-feature="group" id="group-members">
    <h2><%= t("settings.group_members") %></h2>
    <p id="settings-group-info" class="settings-info"></p>

    <div class="group-member-form">
      <input type="text" id="group-member-name" placeholder="<%= t("settings.name_placeholder") %>" class="group-member-input" />
      <input type="email" id="group-member-email" placeholder="<%= t("settings.email_placeholder") %>" class="group-member-input group-member-input-email" />
      <button id="group-add-member" class="settings-btn"><%= t("settings.add") %></button>
    </div>

    <div id="group-member-list"></div>

    <div class="settings-actions" style="margin-top: 1rem;">
      <button id="settings-export-group" class="settings-btn"><%= t("settings.export") %></button>
      <button id="settings-import-group" class="settings-btn"><%= t("settings.import") %></button>
      <input type="file" id="settings-import-group-file" accept=".json" style="display:none;" />
      <button id="settings-clear-group" class="settings-btn settings-btn-danger"><%= t("settings.clear_members") %></button>
    </div>
  </section>

  <section class="settings-section">
    <h2><%= t("settings.progress_data") %></h2>
    <p class="settings-info"><%= t("settings.progress_info") %></p>

    <% site.data.studies.reject { |s| s["hidden"] }.each do |study| %>
      <%
        data_key  = study["slug"].gsub('-', '_')
        study_cfg = site.data.send(data_key).study_config
      %>
      <div class="settings-progress-study"
           data-study-slug="<%= study["slug"] %>"
           data-storage-prefix="<%= study_cfg["storage_prefix"] %>"
           data-config="<%= study_cfg.to_json %>">
        <h3 class="settings-progress-study-title"><%= study["title"] %></h3>
        <p class="settings-progress-study-info settings-info"></p>

        <div class="settings-actions">
          <button class="settings-btn settings-export-progress"><%= t("settings.export") %></button>
          <button class="settings-btn settings-import-progress"><%= t("settings.import") %></button>
          <input type="file" class="settings-import-progress-file" accept=".json" style="display:none;" />
          <button class="settings-btn settings-btn-danger settings-clear-progress"><%= t("settings.clear_progress") %></button>
        </div>
      </div>
    <% end %>
  </section>

  <section class="settings-section">
    <h2><%= t("settings.storage") %></h2>
    <p id="settings-storage-info" class="settings-info"></p>
  </section>

  <section class="settings-section">
    <h2><%= t("settings.debug") %></h2>
    <p class="settings-info"><%= t("settings.debug_info") %></p>
    <div class="settings-actions">
      <button id="settings-reset-banner" class="settings-btn"><%= t("settings.reset_banner") %></button>
      <button id="settings-reset-tip" class="settings-btn"><%= t("settings.reset_tip") %></button>
    </div>
  </section>

  <div id="settings-status" class="settings-status"></div>

  <%# Every message settings.js can show, in this page's language. %>
  <script id="settings-messages" type="application/json"><%== t("settings_js").to_json %></script>
</article>
