<div class="site-top">
  <a href="<%= relative_url '/' %>" class="site-logo-link">
    <img src="<%= relative_url '/images/site-logo.jpg' %>" alt="<%= @metadata.title %>" class="site-logo" />
  </a>

  <div class="site-top-right">
    <header class="site-header">
      <% if study_slug && study_title %>
        <a href="<%= relative_url "#{study_prefix}/" %>" class="site-brand site-brand-study"><%= study_title %></a>
      <% else %>
        <a href="<%= relative_url '/' %>" class="site-brand"><%= @metadata.title %></a>
      <% end %>
    </header>

    <div class="page-toolbar">
      <div class="toolbar-center">
        <a href="<%= relative_url '/' %>" class="toolbar-icon">Home</a>
        <a href="<%= relative_url '/blog/' %>" class="toolbar-icon">Essays</a>
        <% if @resource.data[:week] %>
          <a href="../memory-verse/" class="toolbar-icon">Verse</a>
        <% end %>
        <% if @resource.data[:week] && @resource.data[:day] %>
          <a href="<%= relative_url "#{study_prefix}/hear-journal/" %>?week=<%= @resource.data[:week] %>&day=<%= @resource.data[:day] %>&reading=<%= ERB::Util.url_encode(@resource.data[:reading].to_s) %>&title=<%= ERB::Util.url_encode(@resource.data[:title].to_s) %>" target="_blank" class="toolbar-icon" data-feature="journal">Journal</a>
        <% end %>
        <button class="toolbar-icon toolbar-speak-btn" data-feature="speak">Speak</button>
        <a href="#" id="toolbar-share-email" class="toolbar-icon" data-feature="group">Share</a>
        <button onclick="setTimeout(function(){window.print()},100)" class="toolbar-icon">Print</button>
      </div>

      <div class="toolbar-right">
        <a href="<%= relative_url '/settings/' %>" class="toolbar-icon">Settings</a>
        <a href="<%= relative_url '/documents/about/' %>" class="toolbar-icon">About</a>
      </div>
    </div>
  </div>
</div>
