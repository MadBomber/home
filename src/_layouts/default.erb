<!doctype html>
<html lang="<%= site.locale %>">
  <head>
    <%= render "head", metadata: site.metadata, title: data.title %>
  </head>
  <body class="<%= data.layout %> <%= data.page_class %>" data-base-path="<%= site.base_path.to_s %>">
    <%= render "announcement_banner" %>
    <%= render "tip_of_week" %>
    <%
      _nav_study_slug = resource.data[:study_slug]
      _nav_data_key   = _nav_study_slug&.gsub('-', '_')
      _nav_study_cfg  = _nav_data_key && site.data.respond_to?(_nav_data_key) ? site.data.send(_nav_data_key)&.study_config : nil
      _nav_has_mv     = _nav_study_cfg ? _nav_study_cfg["has_memory_verse"] != false : true
    %>
    <%= render Shared::Navbar.new(
      metadata:           site.metadata,
      resource:           resource,
      studies:            site.data.studies || [],
      resolved_documents: site.data.resolved_documents,
      has_memory_verse:   _nav_has_mv
    ) %>
    <%= render "breadcrumb" %>

    <main>
      <%= yield %>
    </main>

    <%= render "footer", metadata: site.metadata %>

    <%# Inject per-study config for JavaScript consumption.
        Falls back to global data for pages without a study_slug (e.g. landing page, settings)
        or whose study_slug has no data directory (e.g. the blog's tag pages). %>
    <%
      _study_slug = data.study_slug
      _data_key   = _study_slug&.gsub('-', '_')
      _study_data   = _data_key ? site.data.send(_data_key) : nil
      _study_cfg    = _study_data&.study_config    || site.data.study_config
      _study_titles = _study_data&.study_titles    || site.data.study_titles
    %>
    <script id="study-slug-data"   type="application/json"><%== (_study_slug || "").to_json %></script>
    <script id="study-config-data" type="application/json"><%== _study_cfg.to_json %></script>
    <script id="study-titles-data" type="application/json"><%== _study_titles.to_json %></script>
    <script id="announcement-data" type="application/json"><%== site.data.announcement.to_json %></script>
    <script id="tips-data" type="application/json"><%== (site.data.tips_ordered || []).to_json %></script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": <%== site.metadata.title.to_json %>,
      "url": <%== site.config.url.to_json %>,
      "description": <%== site.metadata.description.to_json %>
    }
    </script>
  </body>
</html>
