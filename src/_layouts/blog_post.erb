---
layout: default
---
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": <%= data.title.to_json %>,
  "description": <%= (data.description || "").to_json %>,
  "url": "<%= site.config.url %><%= resource.relative_url %>",
  <% if data.date %>"datePublished": "<%= data.date.iso8601 %>",<% end %>
  <% if !data.author.to_s.empty? %>
  "author": {
    "@type": "Person",
    "name": <%= data.author.to_json %>
  },
  <% end %>
  "publisher": {
    "@type": "Organization",
    "name": <%= site.metadata.title.to_json %>,
    "url": <%= site.config.url.to_json %>
  }
}
</script>

<%
  is_production = Bridgetown.environment.to_s == "production"

  # Selector shared by all post-list queries. Future-dated posts are excluded
  # in production so prev/next nav never links a reader to an unpublished
  # essay ahead of its date, matching the same rule blog/index.erb applies.
  blog_posts = site.resources
    .select { |r| r.relative_url.to_s.match?(%r{\A#{site.base_path}/blog/[^/]+/\z}) }
    .reject { |r| r.relative_url.to_s.end_with?('/blog/') }
    .reject { |r| r.relative_url.to_s.end_with?('/blog/announcement/') }
    .reject { |r| is_production && r.data[:date] && r.data[:date].to_date > Date.today }

  current_collection = data[:collection]

  if current_collection
    # ── Collection post ──────────────────────────────────────────
    coll_posts = blog_posts
      .select  { |r| r.data[:collection] == current_collection }
      .sort_by { |r| r.data[:order].to_i }

    idx         = coll_posts.index { |r| r.relative_url == resource.relative_url }
    older_post  = idx && idx > 0                     ? coll_posts[idx - 1] : nil
    newer_post  = idx && idx < coll_posts.length - 1 ? coll_posts[idx + 1] : nil

    # Boundary fallbacks: find the nearest non-collection post chronologically
    outside = blog_posts.reject { |r| r.data[:collection] == current_collection }

    if older_post.nil?
      # No previous within collection → most recent outside post (sort ascending, take last)
      older_post = outside.sort_by { |r| r.data[:date] || Date.new(1970) }.last
    end

    if newer_post.nil? && data[:date]
      # No next within collection → oldest outside post whose date >= this post's date
      newer_post = outside
        .select  { |r| (r.data[:date] || Date.new(1970)) >= data[:date] }
        .sort_by { |r| r.data[:date] || Date.new(1970) }
        .first
    end
  else
    # ── Standalone post ───────────────────────────────────────────
    all_posts = blog_posts
      .sort_by { |r| r.data[:date] || Date.new(1970) }
      .reverse

    current_index = all_posts.index { |r| r.relative_url == resource.relative_url }
    older_post  = current_index && current_index < all_posts.length - 1 ? all_posts[current_index + 1] : nil
    newer_post  = current_index && current_index > 0                    ? all_posts[current_index - 1] : nil
  end
%>

<article class="blog-post">
  <nav class="blog-post-nav">
    <% if older_post %>
      <a href="<%= relative_url older_post.relative_url %>" class="blog-post-nav-link blog-post-nav-older">
        <span class="blog-post-nav-arrow">&larr;</span>
        <span class="blog-post-nav-title"><%= older_post.data[:title] %><% if older_post.data[:date] %><span class="blog-post-nav-date"> · <%= older_post.data[:date].strftime("%B %-d, %Y") %></span><% end %></span>
      </a>
    <% else %>
      <span></span>
    <% end %>
    <% if newer_post %>
      <a href="<%= relative_url newer_post.relative_url %>" class="blog-post-nav-link blog-post-nav-newer">
        <span class="blog-post-nav-title"><%= newer_post.data[:title] %><% if newer_post.data[:date] %><span class="blog-post-nav-date"> · <%= newer_post.data[:date].strftime("%B %-d, %Y") %></span><% end %></span>
        <span class="blog-post-nav-arrow">&rarr;</span>
      </a>
    <% else %>
      <span></span>
    <% end %>
  </nav>

  <header class="blog-post-header">
    <%
      title_parts = data.title.to_s.split(' — ', 2)
    %>
    <h1>
      <% if title_parts.length == 2 %>
        <span class="h1-collection"><%= title_parts[0] %></span><br>
        <span class="h1-essay"><%= title_parts[1] %></span>
      <% else %>
        <%= data.title %>
      <% end %>
    </h1>
    <p class="blog-post-meta">
      <% if data.date %><span class="blog-post-date"><%= data.date.strftime("%B %-d, %Y") %></span><% end %>
      <%# The byline is a way to write to the author. This essay's path rides
          along in the query string so the contact page can prefill the subject
          with its address — see prefillTopicFromPage in contact.js. %>
      <% if data.author %><a class="blog-post-author" href="<%= relative_url '/contact/' %>?about=<%= ERB::Util.url_encode(resource.relative_url.to_s) %>" title="Write to <%= data.author %> about this essay"><%= data.author %></a><% end %>
    </p>
  </header>

  <div class="blog-post-body">
    <%= yield %>
  </div>

  <nav class="blog-post-nav blog-post-nav-bottom">
    <% if older_post %>
      <a href="<%= relative_url older_post.relative_url %>" class="blog-post-nav-link blog-post-nav-older">
        <span class="blog-post-nav-arrow">&larr;</span>
        <span class="blog-post-nav-title"><%= older_post.data[:title] %><% if older_post.data[:date] %><span class="blog-post-nav-date"> · <%= older_post.data[:date].strftime("%B %-d, %Y") %></span><% end %></span>
      </a>
    <% else %>
      <span></span>
    <% end %>
    <% if newer_post %>
      <a href="<%= relative_url newer_post.relative_url %>" class="blog-post-nav-link blog-post-nav-newer">
        <span class="blog-post-nav-title"><%= newer_post.data[:title] %><% if newer_post.data[:date] %><span class="blog-post-nav-date"> · <%= newer_post.data[:date].strftime("%B %-d, %Y") %></span><% end %></span>
        <span class="blog-post-nav-arrow">&rarr;</span>
      </a>
    <% else %>
      <span></span>
    <% end %>
  </nav>
</article>
