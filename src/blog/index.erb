---
layout: default
title: Essays
description: Essays and articles on Scripture, theology, and the Christian life.
---

<%
  is_production = Bridgetown.environment.to_s == "production"

  all_posts = site.resources
    .select  { |r| r.relative_url.to_s.match?(%r{\A#{site.base_path}/blog/[^/]+/\z}) }
    .reject  { |r| r.relative_url.to_s.end_with?('/blog/') }
    .reject  { |r| r.relative_url.to_s.end_with?('/blog/announcement/') }
    .reject  { |r| is_production && r.data[:date] && r.data[:date].to_date > Date.today }

  collections_meta = (site.data.blog_collections || [])
    .each_with_object({}) { |c, h| h[c["slug"]] = c }

  humanize_slug = ->(slug) { slug.split('-').map(&:capitalize).join(' ') }

  posts_for_collection = ->(slug) {
    all_posts
      .select  { |r| r.data[:collection].to_s == slug }
      .sort_by { |r| r.data[:order] || 999 }
  }

  collections_data = all_posts
    .map     { |r| r.data[:collection].to_s }
    .reject  { |slug| slug.empty? }
    .uniq
    .map { |slug|
      meta   = collections_meta[slug] || {}
      posts  = posts_for_collection.call(slug)
      intro  = posts.find { |p| p.data[:order].to_i == 0 }
      parts  = posts.select { |p| p.data[:order].to_i > 0 }
      dates  = posts.map { |p| p.data[:date] }.compact

      {
        "slug"        => slug,
        "title"       => meta["title"] || humanize_slug.call(slug),
        "description" => meta["description"],
        "first_date"  => intro ? intro.data[:date] : dates.min,
        "latest_date" => dates.max,
        "entry_url"   => intro ? intro.relative_url : (parts.first && parts.first.relative_url),
        "part_count"  => parts.length,
      }
    }

  collections_by_date = collections_data
    .sort_by { |c| c["first_date"] || Date.new(1970) }
    .reverse

  # Recent tab lists "readable units": each standalone essay is one unit, and
  # each collection is a single unit dated by its latest installment. This keeps
  # a collection's parts from scattering across the timeline and preserves the
  # intended reading order (the card links to the collection's entry point).
  standalone_units = all_posts
    .reject { |r| r.data[:collection] && !r.data[:collection].to_s.empty? }
    .map    { |r| { "type" => "post", "date" => r.data[:date], "post" => r } }

  collection_units = collections_data
    .reject { |c| c["entry_url"].nil? }
    .map    { |c| { "type" => "collection", "date" => c["latest_date"], "collection" => c } }

  recent_units = (standalone_units + collection_units)
    .sort_by { |u| u["date"] || Date.new(1970) }
    .reverse
%>

<section class="blog-index">
  <div class="blog-index-hero">
    <h1>Essays</h1>
    <p>Essays and articles on Scripture, theology, and the Christian life.</p>
  </div>

  <div class="blog-tabs" role="tablist">
    <button class="blog-tab active" data-tab="recent" role="tab" aria-selected="true">Recent</button>
    <button class="blog-tab" data-tab="collections" role="tab" aria-selected="false">Collections</button>
    <button class="blog-tab" data-tab="search" role="tab" aria-selected="false">Search</button>
  </div>

  <div class="blog-view active" id="blog-view-recent" role="tabpanel">
    <div class="blog-post-list">
      <% recent_units.each do |unit| %>
        <% if unit["type"] == "post" %>
          <% post = unit["post"] %>
          <a href="<%= relative_url post.relative_url %>" class="blog-post-card">
            <div class="blog-post-card-header">
              <h2><%= post.data[:title] %></h2>
            </div>
            <div class="blog-post-card-body">
              <p class="blog-post-card-meta">
                <% if post.data[:date] %><span class="blog-post-card-date"><%= post.data[:date].strftime("%B %-d, %Y") %></span><% end %>
                <% if post.data[:author] %><span class="blog-post-card-author"><%= post.data[:author] %></span><% end %>
              </p>
              <% if post.data[:description] %>
                <p class="blog-post-card-description"><%= post.data[:description] %></p>
              <% end %>
              <span class="blog-post-card-read">Read article &rarr;</span>
            </div>
          </a>
        <% else %>
          <% collection = unit["collection"] %>
          <a href="<%= relative_url collection["entry_url"] %>" class="blog-post-card blog-post-card-collection-unit">
            <div class="blog-post-card-header">
              <h2><%= collection["title"] %></h2>
              <span class="blog-post-card-collection">Collection<% if collection["part_count"] > 0 %> &middot; <%= collection["part_count"] %> parts<% end %></span>
            </div>
            <div class="blog-post-card-body">
              <p class="blog-post-card-meta">
                <% if collection["latest_date"] %><span class="blog-post-card-date"><%= collection["latest_date"].strftime("%B %-d, %Y") %></span><% end %>
              </p>
              <% if collection["description"] %>
                <p class="blog-post-card-description"><%= collection["description"] %></p>
              <% end %>
              <span class="blog-post-card-read">Begin reading &rarr;</span>
            </div>
          </a>
        <% end %>
      <% end %>

      <% if recent_units.empty? %>
        <p class="blog-empty">No posts yet. Check back soon.</p>
      <% end %>
    </div>
  </div>

  <div class="blog-view" id="blog-view-collections" role="tabpanel">
    <% if collections_by_date.empty? %>
      <p class="blog-empty">No collections yet.</p>
    <% else %>
      <div class="blog-collection-list">
        <% collections_by_date.each do |collection| %>
          <% col_posts = posts_for_collection.call(collection["slug"]) %>
          <% next if col_posts.empty? %>
          <%
            parts     = col_posts.select { |p| p.data[:order].to_i > 0 }
            entry_url = collection["entry_url"]
          %>
          <div class="blog-collection-block">
            <div class="blog-collection-block-header">
              <h2>
                <% if entry_url %>
                  <a href="<%= relative_url entry_url %>"><%= collection["title"] %></a>
                <% else %>
                  <%= collection["title"] %>
                <% end %>
              </h2>
              <% if collection["description"] %>
                <p class="blog-collection-block-description"><%= collection["description"] %></p>
              <% end %>
            </div>
            <% if parts.any? %>
              <ol class="blog-collection-essay-list">
                <% parts.each do |post| %>
                  <%
                    title_parts   = post.data[:title].to_s.split(' — ', 2)
                    display_title = title_parts.length == 2 ? title_parts[1] : title_parts[0]
                  %>
                  <li><a href="<%= relative_url post.relative_url %>"><%= display_title %></a></li>
                <% end %>
              </ol>
            <% end %>
            <% if entry_url %>
              <a href="<%= relative_url entry_url %>" class="blog-collection-start">Begin reading &rarr;</a>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="blog-view" id="blog-view-search" role="tabpanel">
    <form class="blog-search-form" id="blog-search-form" role="search">
      <label class="blog-search-label" for="blog-search-input">Search the essays</label>
      <div class="blog-search-controls">
        <input
          type="search"
          id="blog-search-input"
          class="blog-search-input"
          placeholder="e.g. prayer, Calvin, the elect"
          autocomplete="off"
        >
        <button type="submit" class="blog-search-submit">Search</button>
        <button type="button" class="blog-search-clear" id="blog-search-clear">Clear</button>
      </div>
      <p class="blog-search-hint">
        Searches the full text of every essay. An essay must contain <em>every</em> term to match &mdash;
        put quotation marks around a phrase (&ldquo;Acts 17&rdquo;) to find those words together.
      </p>
    </form>

    <div class="blog-search-results" id="blog-search-results" aria-live="polite"></div>
  </div>
</section>

<script>
(function () {
  var STORAGE_KEY = 'blog-active-tab';
  var tabs  = document.querySelectorAll('.blog-tab');
  var views = document.querySelectorAll('.blog-view');

  function setTab(name) {
    tabs.forEach(function (t) {
      var active = t.dataset.tab === name;
      t.classList.toggle('active', active);
      t.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    views.forEach(function (v) {
      v.classList.toggle('active', v.id === 'blog-view-' + name);
    });
    localStorage.setItem(STORAGE_KEY, name);
  }

  var saved = localStorage.getItem(STORAGE_KEY);
  if (saved) { setTab(saved); }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () { setTab(tab.dataset.tab); });
  });
}());
</script>
