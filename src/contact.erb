---
title: Contact
layout: default
permalink: /contact/
description: Write to LampLight.Guide. The message is composed in your own mail app and sent from your own account.
# One template, rendered once per language. Every visible string comes from
# src/_locales/*.yml (contact); the contact_js map is injected below for
# contact.js.
locale: multi
locale_overrides:
  es:
    title: Contacto
    permalink: /es/contact/
    description: Escribe a LampLight.Guide. El mensaje se redacta en tu propia aplicación de correo y se envía desde tu propia cuenta.
---

<%
  # Contact page.
  #
  # There is no server here to receive a form post, so this composes a mailto:
  # in the reader's own mail client — the same mechanism group-share.js uses to
  # send a day's reading to a study group. Nothing is transmitted to this site,
  # and no third-party form service sits in the middle.
  #
  # The address itself is assembled at runtime in contact.js rather than written
  # into this markup, which keeps it out of reach of the crawlers that harvest
  # mailto: hrefs. Everything below degrades to a plain "here is the address"
  # page when JavaScript is off.

  _topics = t("contact.topics")
%>

<article id="contact-page">
  <h1><%= data.title %></h1>

  <p class="contact-intro"><%= t("contact.intro") %></p>

  <%# Filled in and revealed by contact.js when a reader arrives from an essay
      byline or the footer link. Hidden otherwise, and never rendered with a
      title taken from the URL. %>
  <p id="contact-page-note" class="contact-page-note" hidden></p>

  <form id="contact-form" class="settings-section" novalidate>
    <div class="contact-field">
      <label for="contact-name" class="contact-label"><%= t("contact.name_label") %> <span class="contact-optional"><%= t("contact.optional") %></span></label>
      <input type="text" id="contact-name" class="group-member-input contact-input" autocomplete="name" />
    </div>

    <div class="contact-field">
      <label for="contact-topic" class="contact-label"><%= t("contact.topic_label") %></label>
      <select id="contact-topic" class="settings-select contact-input">
        <% _topics.each do |topic| %>
          <option value="<%= topic %>"><%= topic %></option>
        <% end %>
      </select>
    </div>

    <div class="contact-field">
      <label for="contact-message" class="contact-label"><%= t("contact.message_label") %></label>
      <textarea id="contact-message" rows="8" class="group-member-input contact-input contact-textarea"
                placeholder="<%= t("contact.message_placeholder") %>"></textarea>
    </div>

    <div class="settings-actions">
      <button type="submit" class="settings-btn"><%= t("contact.submit") %></button>
    </div>

    <p id="contact-status" class="settings-status" role="status" aria-live="polite"></p>
  </form>

  <section class="settings-section">
    <h2><%= t("contact.direct_heading") %></h2>
    <p class="settings-info"><%= t("contact.direct_info") %></p>
    <p>
      <a href="#" id="contact-address-link" class="contact-address"><%= t("contact.loading") %></a>
    </p>
    <div class="settings-actions">
      <button type="button" id="contact-copy-address" class="settings-btn"><%= t("contact.copy_address") %></button>
    </div>
  </section>
</article>

<script id="contact-messages" type="application/json"><%== t("contact_js").to_json %></script>
