---
layout: default
title: Page Not Found
permalink: /404.html
---

<%# A static host serves this one file for every missing address, English or
    Spanish, so it carries its message in every language at once: one
    [data-lang-block] per locale, English visible by default, and not-found.js
    shows the one that matches the address (/es/...) or the reader's chosen
    language. All wording is in src/_locales under not_found. %>
<%
  _default_locale = site.config.default_locale.to_sym
  _card_style = "background:var(--bg-surface); border-radius:var(--radius); box-shadow:var(--shadow-sm); padding:1.5rem 1.75rem;"
%>

<% site.config.available_locales.map(&:to_sym).each do |loc| %>
<%
  nf     = ->(key, **opts) { I18n.t("not_found.#{key}", locale: loc, **opts) }
  steps  = nf.call("steps")
  prefix = loc == _default_locale ? "" : "/#{loc}"
  home   = site.resources.any? { |r| r.relative_url.to_s == "#{site.base_path}#{prefix}/" } ? "#{prefix}/" : "/"
%>
<div data-lang-block="<%= loc %>" lang="<%= loc %>" data-title="<%= nf.call("title") %> | <%= site.metadata.title %>"<%= " hidden" unless loc == _default_locale %>>

<%# ── Top card ─────────────────────────────────────────────── %>
<div style="display:flex; align-items:center; justify-content:center; padding:2rem 1rem 1rem;">
  <div style="display:flex; align-items:stretch; max-width:56rem; width:100%; background:var(--bg-surface); border-radius:calc(var(--radius)*2); box-shadow:var(--shadow-md); overflow:hidden;">

    <div style="flex:0 0 42%; min-height:22rem; overflow:hidden;">
      <img src="<%= relative_url '/images/404.jpg' %>"
           alt="<%= nf.call("image_alt") %>"
           style="width:100%; height:100%; object-fit:cover; display:block;">
    </div>

    <div style="flex:1; padding:2.5rem 2.5rem 2.5rem 2rem; display:flex; flex-direction:column; justify-content:center;">
      <div style="display:inline-block; font-size:0.75rem; font-family:var(--font-sans); font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--purple-light); border:1.5px solid var(--purple-light); border-radius:2rem; padding:0.25rem 0.85rem; margin-bottom:1rem; width:fit-content;">
        <%= nf.call("badge") %>
      </div>
      <h1 style="font-size:1.75rem; margin:0 0 0.75rem; line-height:1.25;">
        <%= nf.call("heading") %>
      </h1>
      <p style="color:var(--text-secondary); margin:0 0 1.25rem; line-height:1.7;">
        <%= nf.call("body") %>
      </p>
      <blockquote style="border-left:3px solid var(--gold); padding-left:1rem; margin:0 0 1.75rem; font-style:italic; color:var(--text-secondary);">
        <%= nf.call("verse") %>
        <cite style="display:block; margin-top:0.35rem; font-size:0.85rem; font-style:normal; color:var(--gold);"><%= nf.call("verse_ref") %></cite>
      </blockquote>
      <a href="<%= relative_url home %>" style="display:inline-block; background:var(--purple-mid); color:#fff; font-weight:700; font-family:var(--font-sans); text-decoration:none; padding:0.65rem 1.75rem; border-radius:var(--radius); width:fit-content;">
        <%= nf.call("home") %>
      </a>
    </div>

  </div>
</div>

<%# ── Romans Road ─────────────────────────────────────────── %>
<div style="max-width:56rem; margin:0 auto; padding:1rem 1rem 3rem;">

  <h2 style="text-align:center; font-size:1.4rem; margin:2rem 0 0.5rem; color:var(--purple-light); letter-spacing:0.03em;">
    <%= nf.call("path_heading") %>
  </h2>
  <p style="text-align:center; color:var(--text-muted); font-family:var(--font-sans); font-size:0.9rem; margin:0 0 2rem;">
    <%= nf.call("path_intro") %>
  </p>

  <div style="display:flex; flex-direction:column; gap:1.25rem;">
    <%# The last step is the destination (deep purple card); the one before it
        is the promise (gold edge); the rest share the plain card. %>
    <% steps.each_with_index do |step, i| %>
      <%
        last      = i == steps.length - 1
        promise   = i == steps.length - 2
        card      = last ? "background:var(--purple-deep); border-radius:var(--radius); box-shadow:var(--shadow-md); padding:1.75rem 1.75rem;" : _card_style
        edge      = last || promise ? "var(--gold)" : "var(--purple-mid)"
        text      = last ? "color:#fff; opacity:0.9;" : "color:var(--text-secondary);"
      %>
      <div style="<%= card %> border-left:4px solid <%= edge %>;">
        <p style="margin:0 0 0.75rem; line-height:1.7; <%= text %>">
          <%= step[:text] %>
        </p>
        <blockquote style="margin:0; padding-left:1rem; border-left:3px solid var(--gold); font-style:italic; <%= text %>">
          <%= step[:verse] %>
          <cite style="display:block; margin-top:0.3rem; font-size:0.85rem; font-style:normal; color:var(--gold);"><%= step[:ref] %></cite>
        </blockquote>
      </div>
    <% end %>
  </div>

</div>

</div>
<% end %>
