# frozen_string_literal: true
# book.loki — build the printable study books (see scripts/book/).
#
# Each study under src/<slug>/ becomes a PDF via four stages:
#
#   reference  ->  build/<slug>/reference.docx   style template
#   draft      ->  build/<slug>/draft.md         concatenated weekly overviews
#   docx       ->  build/<slug>/<slug>.docx      pandoc, with a real Word TOC field
#   pdf        ->  build/<slug>/<slug>.pdf       headless LibreOffice
#
# Each study also has a 5-page handout: an overview page plus the weekly Bible
# references as a calendar, a quarter (13 weeks) to a page, with book names
# abbreviated to fit the cells.
#
#   handout    ->  build/<slug>/<slug>-handout.pdf
#
# Usage:
#   asgard book studies              # list what can be built
#   asgard book build ntc1y          # run the whole pipeline for one study
#   asgard book handout ntc1y        # build the short reference handout
#   asgard book all                  # build every study
#   asgard book pdf ntc1y            # re-export just the PDF
#   asgard book status               # what is built, how big, how many pages
#   asgard book open ntc1y handout   # open a built PDF
#   asgard book publish              # copy the PDFs into src/downloads/
#   asgard book doctor               # check the external tools are present
#
# The study sources under src/ are read-only and everything the pipeline
# generates lands in build/, which is gitignored. `publish` is the one exception:
# it copies finished PDFs into src/downloads/ and registers them in
# src/_data/downloads.yml so the site can serve them, and those copies are meant
# to be committed. Nothing else writes under src/.

class BookCommands < Tasks
  desc "studies", "List the studies that can be built"
  def studies
    rows = study_slugs.map do |slug|
      cfg = study_config(slug)
      [slug, cfg["sections"], cfg["weeks"], book_title(slug)]
    end

    puts ""
    puts format("  %-8s %8s %6s  %s", "STUDY", "SECTIONS", "WEEKS", "TITLE")
    puts "  #{'─' * 68}"
    rows.each { |r| puts format("  %-8s %8s %6s  %s", *r) }
    puts ""
  end

  desc "reference SLUG", "Rebuild the .docx style template (fonts, margins, header, footer)"
  def reference(slug = nil)
    stage "build_reference.rb", require_slug(slug)
  end

  desc "draft SLUG", "Concatenate the study's weekly overviews into draft.md"
  def draft(slug = nil)
    stage "build_draft.rb", require_slug(slug)
  end

  desc "docx SLUG", "Build the Word document from draft.md (needs pandoc)"
  def docx(slug = nil)
    stage "build_docx.rb", require_slug(slug)
  end

  desc "pdf SLUG", "Export the PDF from the Word document (needs LibreOffice)"
  def pdf(slug = nil)
    stage "build_pdf.rb", require_slug(slug)
  end

  desc "handout SLUG", "Build the 5-page handout: overview plus a quarter-per-page reference calendar"
  def handout(slug = nil)
    slug = require_slug(slug)
    # The handout has its own style template: equal side margins instead of the
    # book's mirrored ones, and a centered header.
    stage "build_reference.rb", slug, "handout" unless artifact(slug, "reference-handout.docx").exist?
    stage "build_handout.rb", slug
    stage "build_pdf.rb", slug, "handout"

    puts ""
    puts "  #{slug} handout: #{describe_pdf(slug, handout: true)}"
  end

  desc "build SLUG", "Run the whole pipeline for one study"
  option :reference,
         aliases: "-r",
         type:    :boolean,
         default: false,
         desc:    "Rebuild the style template even if it already exists"
  def build(slug = nil)
    build_study require_slug(slug), reference: options[:reference]
  end

  desc "all", "Build every study"
  option :reference,
         aliases: "-r",
         type:    :boolean,
         default: false,
         desc:    "Rebuild the style templates too"
  def all
    # Calls the helper rather than `invoke :build`: Thor runs a given command
    # only once per invocation, so invoking build in a loop silently built the
    # first study and skipped the rest.
    study_slugs.each do |slug|
      puts "\n\e[1;33m── #{slug}\e[0m"
      build_study slug, reference: options[:reference]
    end
  end

  desc "status", "Show which artifacts exist for each study"
  def status
    puts ""
    puts format("  %-8s %-20s %10s  %s", "STUDY", "ARTIFACT", "SIZE", "DETAIL")
    puts "  #{'─' * 68}"

    study_slugs.each do |slug|
      %w[draft.md reference.docx].each { |n| puts artifact_row(slug, n) }
      puts artifact_row(slug, "#{slug}.docx")
      puts artifact_row(slug, "#{slug}.pdf", detail: describe_pdf(slug))
      puts artifact_row(slug, "reference-handout.docx")
      puts artifact_row(slug, "#{slug}-handout.docx")
      puts artifact_row(slug, "#{slug}-handout.pdf", detail: describe_pdf(slug, handout: true))
    end
    puts ""
  end

  desc "clean [SLUG]", "Delete generated artifacts (all studies when SLUG is omitted)"
  def clean(slug = nil)
    targets = slug ? [require_slug(slug)] : study_slugs
    targets.each do |s|
      dir = build_dir(s)
      if dir.directory?
        FileUtils.rm_rf dir
        puts "  removed #{dir.relative_path_from(repo_root)}"
      else
        puts "  nothing to remove for #{s}"
      end
    end
  end

  desc "open SLUG [KIND]", "Open a built PDF in the default viewer; KIND is book (default) or handout"
  def open(slug = nil, kind = "book")
    slug = require_slug(slug)
    unless %w[book handout].include?(kind)
      abort "unknown kind #{kind.inspect} -- use book or handout"
    end

    name = kind == "handout" ? "#{slug}-handout.pdf" : "#{slug}.pdf"
    pdf  = artifact(slug, name)
    task = kind == "handout" ? "handout" : "build"
    abort "no #{name} yet -- run: asgard book #{task} #{slug}" unless pdf.exist?

    sh "open #{pdf}"
  end

  desc "publish [SLUG]", "Copy the built book and handout PDFs into src/downloads/ and register them in downloads.yml"
  option :docx,
         type:    :boolean,
         default: false,
         desc:    "Publish the Word versions alongside the PDFs"
  def publish(slug = nil)
    targets = slug ? [require_slug(slug)] : study_slugs

    FileUtils.mkdir_p downloads_dir
    puts ""
    published = targets.flat_map { |s| publish_study(s, docx: options[:docx]) }

    if published.empty?
      puts ""
      puts "  nothing published -- build the artifacts first: asgard book all"
      return
    end

    register_downloads published
  end

  desc "doctor", "Check that the external tools the pipeline needs are installed"
  def doctor
    checks = {
      "pandoc"      => "markdown -> .docx",
      "officecli"   => "styles, header/footer, title image",
      "soffice"     => "headless .docx -> .pdf",
      "mutool"      => "optional: PDF page counts for `status`"
    }

    puts ""
    missing = []
    checks.each do |tool, why|
      path = which(tool)
      mark = path ? "\e[32mok\e[0m  " : "\e[31mMISSING\e[0m"
      puts format("  %-11s %-8s %-38s %s", tool, mark, why, path || "")
      missing << tool unless path
    end
    puts ""

    unless missing.empty?
      puts "  install with:"
      puts "    brew install pandoc" if missing.include?("pandoc")
      puts "    brew install --cask libreoffice" if missing.include?("soffice")
      puts "    brew install mupdf-tools" if missing.include?("mutool")
      puts "    curl -fsSL https://d.officecli.ai/install.sh | bash" if missing.include?("officecli")
      puts ""
    end
  end

  no_commands do
    def build_study(slug, reference: false)
      # The style template rarely changes, so it is only built when missing --
      # or when asked for explicitly after editing build_reference.rb.
      stage "build_reference.rb", slug if reference || !artifact(slug, "reference.docx").exist?

      stage "build_draft.rb", slug
      stage "build_docx.rb",  slug
      stage "build_pdf.rb",   slug

      puts ""
      puts "  #{slug}: #{describe_pdf(slug)}"
    end

    # The .loki lives at the repo root, so walking up from the working directory
    # to find it locates the repo without asgard having to be run from there.
    def repo_root
      @repo_root ||= begin
        dir = Pathname.new(Dir.pwd).expand_path
        dir = dir.parent until (dir + ".loki").exist? || dir.root?
        dir
      end
    end

    def scripts_dir = repo_root + "scripts/book"
    def build_dir(slug) = repo_root + "build/#{slug}"
    def artifact(slug, name) = build_dir(slug) + name

    # Where `publish` writes. The site serves src/downloads/ as static files and
    # reads src/_data/downloads.yml to decide what to list.
    def downloads_dir  = repo_root + "src/downloads"
    def downloads_yaml = repo_root + "src/_data/downloads.yml"

    # The group in downloads.yml that publish owns. Anything a human adds under a
    # different heading is never touched.
    DOWNLOADS_GROUP = "Study Books"
    DOWNLOADS_GROUP_DESCRIPTION =
      "Each study as one printable volume, plus a short reference handout you can " \
      "keep in your Bible."

    # Copy one study's finished artifacts into src/downloads/. Returns a
    # descriptor per file that made it, for register_downloads to list.
    def publish_study(slug, docx: false)
      wanted = [
        { kind: :book,    name: "#{slug}.pdf" },
        { kind: :handout, name: "#{slug}-handout.pdf" },
      ]
      if docx
        wanted << { kind: :book,    name: "#{slug}.docx" }
        wanted << { kind: :handout, name: "#{slug}-handout.docx" }
      end

      wanted.filter_map do |spec|
        source = artifact(slug, spec[:name])

        unless source.exist?
          task = spec[:kind] == :handout ? "handout" : "build"
          puts format("  %-8s %-24s %s", slug, spec[:name],
                      "not built -- run: asgard book #{task} #{slug}")
          next
        end

        dest = downloads_dir + spec[:name]

        # Skip the copy when the published file already matches, so a routine
        # publish leaves the working tree alone and git stays quiet.
        if dest.exist? && dest.size == source.size && dest.mtime >= source.mtime
          puts format("  %-8s %-24s %10s  %s", slug, spec[:name],
                      human_size(dest.size), "already current")
        else
          FileUtils.cp source, dest
          puts format("  %-8s %-24s %10s  %s", slug, spec[:name],
                      human_size(dest.size), "published")
        end

        spec.merge(slug: slug)
      end
    end

    # Add an entry to downloads.yml for anything not already listed.
    #
    # Titles and descriptions are only ever written for a file that is new to the
    # registry, so editing the wording by hand survives every later publish. The
    # file is left untouched when there is nothing to add, which also keeps any
    # comments written inside the data intact -- a rewrite preserves the comment
    # header at the top of the file but not comments among the entries.
    def register_downloads(entries)
      raw    = downloads_yaml.exist? ? downloads_yaml.read : ""
      header = raw[/\A(?:[ \t]*(?:#.*)?\n)*/].to_s

      # A registry that does not parse is a hand-editing mistake, not something to
      # guess at: rewriting it from what little parsed would throw away entries.
      # The files above are already copied and valid, so only this step stops.
      begin
        groups = YAML.safe_load(raw)
      rescue Psych::SyntaxError => e
        puts ""
        abort "  src/_data/downloads.yml does not parse (line #{e.line}): #{e.problem}.\n" \
              "  The files were copied; fix the YAML and run publish again to register them."
      end
      groups = [] unless groups.is_a?(Array)

      group = groups.find { |g| g.is_a?(Hash) && g["title"] == DOWNLOADS_GROUP }
      unless group
        group = {
          "title"       => DOWNLOADS_GROUP,
          "description" => DOWNLOADS_GROUP_DESCRIPTION,
          "items"       => [],
        }
        groups << group
      end
      group["items"] = [] unless group["items"].is_a?(Array)

      listed = groups.flat_map { |g| Array(g["items"]) }
                     .filter_map { |i| i["file"] if i.is_a?(Hash) }

      added = entries.reject { |e| listed.include?(e[:name]) }
      added.each { |e| group["items"] << registry_entry(e) }

      puts ""
      if added.empty?
        puts "  downloads.yml: every published file is already listed"
        return
      end

      body = YAML.dump(groups).sub(/\A---\s*\n/, "")
      downloads_yaml.write("#{header}#{body}")

      puts "  downloads.yml: added #{added.size} #{added.size == 1 ? 'entry' : 'entries'}"
      added.each { |e| puts "    #{e[:name]}" }
    end

    # The default wording for a newly registered file. Deliberately plain: it is a
    # starting point to edit on the page, not final copy.
    def registry_entry(entry)
      word    = File.extname(entry[:name]).delete_prefix(".").downcase == "docx"
      name    = study_name(entry[:slug])
      handout = entry[:kind] == :handout

      qualifiers = []
      qualifiers << "Reading Calendar" if handout
      qualifiers << "Word" if word

      description = if handout
        "Five pages: an overview, plus every week's readings as a calendar, " \
        "a quarter to a page."
      else
        "All #{study_config(entry[:slug])['weeks']} weeks in one volume, " \
        "formatted for letter paper."
      end
      description += " Word format, for anyone who wants to edit or reformat it." if word

      {
        "title"       => qualifiers.empty? ? name : "#{name} (#{qualifiers.join(', ')})",
        "description" => description,
        "file"        => entry[:name],
      }
    end

    # The reader-facing study name, taken from the same registry the landing page
    # cards use so a download is called what the site calls it. Falls back to the
    # book title in index.md frontmatter.
    def study_name(slug)
      @study_names ||= begin
        path = repo_root + "src/_data/studies.yml"
        list = path.exist? ? YAML.safe_load(path.read) : nil
        Array(list).each_with_object({}) do |study, names|
          names[study["slug"]] = study["title"] if study.is_a?(Hash)
        end
      end

      @study_names[slug] || book_title(slug)
    end

    def study_slugs
      @study_slugs ||= Dir.glob(scripts_dir + "studies/*.yml")
                          .map { |f| File.basename(f, ".yml") }.sort
    end

    def study_config(slug)
      (@study_configs ||= {})[slug] ||=
        YAML.safe_load(File.read(scripts_dir + "studies/#{slug}.yml")) || {}
    end

    # Book titles live in the study's own index.md frontmatter, not in the
    # build config, so the two cannot drift apart.
    def book_title(slug)
      index = repo_root + "src/#{slug}/index.md"
      return "(no index.md)" unless index.exist?

      fm = index.read[/\A---\n(.*?)\n---\n/m, 1].to_s
      (YAML.safe_load(fm) || {})["title"] || "(untitled)"
    rescue StandardError
      "(unreadable)"
    end

    def require_slug(slug)
      if slug.nil? || slug.to_s.strip.empty?
        abort "which study? one of: #{study_slugs.join(', ')}"
      end
      unless study_slugs.include?(slug)
        abort "unknown study #{slug.inspect} -- available: #{study_slugs.join(', ')}"
      end

      slug
    end

    # Extra arguments are passed through, e.g. build_pdf.rb <slug> handout.
    def stage(script, slug, *extra)
      sh "ruby #{scripts_dir + script} #{slug} #{extra.join(' ')}".strip
    end

    def which(tool)
      path = `which #{tool} 2>/dev/null`.strip
      return path unless path.empty?
      # LibreOffice often is not on PATH even when installed.
      app = "/Applications/LibreOffice.app/Contents/MacOS/soffice"
      tool == "soffice" && File.executable?(app) ? app : nil
    end

    def artifact_row(slug, name, detail: nil)
      path = artifact(slug, name)
      if path.exist?
        format("  %-8s %-20s %10s  %s", slug, name, human_size(path.size), detail || "")
      else
        format("  %-8s %-20s %10s  %s", slug, name, "-", "not built")
      end
    end

    def describe_pdf(slug, handout: false)
      path = artifact(slug, handout ? "#{slug}-handout.pdf" : "#{slug}.pdf")
      return "not built" unless path.exist?
      return human_size(path.size) unless which("mutool")

      pages = `mutool info #{path} 2>/dev/null`[/^Pages:\s*(\d+)/, 1]
      pages ? "#{pages} pages, #{human_size(path.size)}" : human_size(path.size)
    end

    def human_size(bytes)
      units = %w[B KB MB GB]
      value = bytes.to_f
      unit  = 0
      while value >= 1024 && unit < units.size - 1
        value /= 1024
        unit  += 1
      end
      unit.zero? ? "#{bytes} B" : format("%.1f %s", value, units[unit])
    end
  end
end

class Tasks
  desc "book SUBCOMMAND", "Build the printable study books"
  subcommand "book", BookCommands
end

# BookCommands inherits Tasks for the Asgard DSL, which also inherits the
# top-level commands. Drop them so `asgard book help` lists only book tasks.
# Done after the subcommand registration above, since that is what adds `book`.
BookCommands.remove_command :book, :tree
